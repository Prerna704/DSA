import java.util.*;
class SecondsToTime {
   //type your code here
   int sec;
   int hr;
   int min;
   public SecondsToTime(int sec){
       this.sec = sec;
   }
   
   public void displayTime(){
       
       min = (sec % 3600)/60;
       hr = sec / 3600;
       sec = (sec % 3600)% 60;
       System.out.printf("%02d : %02d : %02d", hr,min,sec);
   }
   public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int totalSeconds = scanner.nextInt();
        scanner.close();

        SecondsToTime timeConverter = new SecondsToTime(totalSeconds);
        timeConverter.displayTime();
    }
}
   
   
